# Optional. When set, Search runs inside a transaction that calls
# SELECT set_config('app.tenant_id', $1, true) and reads documents under RLS.
# Use aperture_app. The compose superuser bypasses RLS.
APERTURE_DATABASE_URL=postgres://aperture_app:aperture_app@127.0.0.1:5432/aperture
APERTURE_CLICKHOUSE_URL=http://127.0.0.1:8123
APERTURE_HTTP=0.0.0.0:8080
APERTURE_GRPC=0.0.0.0:50051
APERTURE_WEB=web
